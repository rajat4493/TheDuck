{
  "name": "theduck",
  "version": "0.1.0",
  "private": true,
  "description": "TheDuck — the human-intent gate for AI software creation. M1.1 lock core.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test",
    "render:examples": "node --experimental-strip-types scripts/render-examples.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
